      <column caption='Has_Children' datatype='string' name='[Calculation_133419184739078144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Total_Children] &gt; 0 THEN &quot;Has Children&quot; ELSE &quot;No Children&quot; END' />
      </column>
      <column caption='Age Categories' datatype='string' name='[Calculation_133419184739729409]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &lt;= 25 THEN &quot;≤25&quot;&#13;&#10;ELSEIF [Age] &lt;= 35 THEN &quot;26–35&quot;&#13;&#10;ELSEIF [Age] &lt;= 45 THEN &quot;36–45&quot;&#13;&#10;ELSEIF [Age] &lt;= 55 THEN &quot;46–55&quot;&#13;&#10;ELSE &quot;≥56&quot; END' />
      </column>
      <column caption='Promo Group' datatype='string' name='[Calculation_133419184740278275]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [1Campaign] = 1&#13;&#10;OR [2Campaign] = 1&#13;&#10;OR [3Campaign] = 1&#13;&#10;OR [4Campaign] = 1&#13;&#10;OR [5Campaign] = 1&#13;&#10;OR [Response] = 1&#13;&#10;THEN &quot;Promo Accepted&quot;&#13;&#10;ELSE &quot;No Promo&quot;&#13;&#10;END' />
      </column>
      <column caption='Web Conversion' datatype='real' name='[Calculation_133419184740593669]' role='measure' type='quantitative'>
